use Drupal\Core\Entity\EntityTypeInterface;
use Drupal\Core\Field\BaseFieldDefinition;
use Drupal\taxonomy\Entity\Vocabulary;

/**
 * Implement hook_entity_base_field_info
 *
 * @param EntityTypeInterface $entity_type
 */
function marketplacehbk_entity_base_field_info(EntityTypeInterface $entity_type) {
  $fields = [];
  if ($entity_type->id() == 'commerce_product') {
    /**
     * On ajoute un champs durée de traiement en jour.
     * Cette valeur serra ajouter sur celle determiner par le plugin de
     * livraison.
     */
    $fields["hbk_duree_traitement"] = BaseFieldDefinition::create('integer')->setLabel(" Durée traitement supplementaire en heures ")->setRevisionable(TRUE)->setSettings([
      'min' => 0
    ])->setDisplayOptions('view', [
      'label' => 'above',
      'type' => 'marketplacehbk_shipping_estimation',
      'weight' => -4
    ])->setDisplayOptions('form', [
      'type' => 'number'
    ])->setDisplayConfigurable('form', TRUE)->setDisplayConfigurable('view', TRUE)->setDefaultValue(0)->setDescription(
      "Definissez une durée supplementaire qui s'ajoutera à la valeur de livraison par defaut");
  }
  return $fields;
}

