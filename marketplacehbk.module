/**
 * Pour faciliter utilisation des vocabulaire dans l'administration
 * Implement hook_form_FORM_ID_alter
 */
function marketplacehbk_form_field_config_edit_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  /**
   * Ajoute la description devant chaque terme afin qu'on puisse identifier
   * facilement le terme.
   */
  // dump($form);
  if (!empty($form['default_value']['widget'][0]['target_id']['#target_type']) && $form['default_value']['widget'][0]['target_id']['#target_type'] == 'taxonomy_term' && !empty(
    $form['settings']['handler']['handler_settings']['target_bundles']['#options'])) {
    foreach ($form['settings']['handler']['handler_settings']['target_bundles']['#options'] as $k => $value) {
      $voc = Vocabulary::load($k);
      if ($voc) {
        $form['settings']['handler']['handler_settings']['target_bundles']['#options'][$k] = $value . ' >> ' . $voc->getDescription();
      }
    }
  }
  elseif (!empty($form['default_value']['widget']['#target_type']) && $form['default_value']['widget']['#target_type'] == 'taxonomy_term' && !empty(
    $form['settings']['handler']['handler_settings']['target_bundles']['#options'])) {
    foreach ($form['settings']['handler']['handler_settings']['target_bundles']['#options'] as $k => $value) {
      $voc = Vocabulary::load($k);
      if ($voc) {
        $form['settings']['handler']['handler_settings']['target_bundles']['#options'][$k] = $value . ' >> ' . $voc->getDescription();
      }
    }
  }
}